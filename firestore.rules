rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isSafeSize() {
      return request.resource.data.size() < 512 * 1024;
    }

    // /users/{uid} — user profile
    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid) && isSafeSize();
      allow update: if isOwner(uid) && isSafeSize();
      allow delete: if isOwner(uid);

      match /settings/{doc} {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid) && isSafeSize();
      }

      match /sessions/{sessionId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && isSafeSize();
        allow update: if isOwner(uid) && isSafeSize();
        allow delete: if isOwner(uid);

        match /messages/{messageId} {
          allow read:   if isOwner(uid);
          allow create: if isOwner(uid) && isSafeSize();
          allow update: if isOwner(uid) && isSafeSize();
          allow delete: if isOwner(uid);
        }
      }

      match /security/{doc} {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid) && isSafeSize();
      }

      match /activeSessions/{sessionId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && isSafeSize();
        allow update: if isOwner(uid) && isSafeSize();
        allow delete: if isOwner(uid);
      }

      match /trustedContacts/{contactId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && isSafeSize();
        allow update: if isOwner(uid) && isSafeSize();
        allow delete: if isOwner(uid);
      }

      match /family/{memberId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && isSafeSize();
        allow update: if isOwner(uid) && isSafeSize();
        allow delete: if isOwner(uid);
      }

      match /keyboardShortcuts/{shortcutId} {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid) && isSafeSize();
      }

      match /dataControls/{doc} {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid) && isSafeSize();
      }

      match /storage/{doc} {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid) && isSafeSize();
      }

      match /safetyConfig/{doc} {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid) && isSafeSize();
      }

      match /notifications/{doc} {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid) && isSafeSize();
      }

      // imageQuota is backend-write only via Admin SDK
      match /imageQuota/{doc} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }

      match /projects/{projectId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && isSafeSize();
        allow update: if isOwner(uid) && isSafeSize();
        allow delete: if isOwner(uid);
      }

      match /exports/{exportId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && isSafeSize();
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    // Global quota stats — read-only for authenticated users, write by Admin SDK only
    match /imageQuotaGlobal/{doc} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}