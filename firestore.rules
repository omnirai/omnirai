rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // SECURITY HELPER FUNCTIONS
    // ==========================================
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isSafeSize() {
      return request.resource == null || request.resource.data.size() < 512 * 1024;
    }

    // ==========================================
    // 1. USER ACCOUNT PROFILES & SUBCOLLECTIONS
    // ==========================================
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isSafeSize();

      // App Settings & Preferences
      match /settings/{doc} {
        allow read, write: if isOwner(userId) && isSafeSize();
      }

      // User Chat History & Messages
      match /chats/{chatId} {
        allow read, write: if isOwner(userId) && isSafeSize();

        match /messages/{messageId} {
          allow read, write: if isOwner(userId) && isSafeSize();
        }
      }

      // Chat Sessions & Conversations
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId) && isSafeSize();

        match /messages/{messageId} {
          allow read, write: if isOwner(userId) && isSafeSize();
        }
      }

      // User Projects & Code Files
      match /projects/{projectId} {
        allow read, write: if isOwner(userId) && isSafeSize();

        match /files/{fileId} {
          allow read, write: if isOwner(userId) && isSafeSize();
        }
      }

      // Security, Auth Devices & Sessions
      match /security/{doc} {
        allow read, write: if isOwner(userId) && isSafeSize();
      }

      match /activeSessions/{sessionId} {
        allow read, write: if isOwner(userId) && isSafeSize();
      }

      match /trustedContacts/{contactId} {
        allow read, write: if isOwner(userId) && isSafeSize();
      }

      match /family/{memberId} {
        allow read, write: if isOwner(userId) && isSafeSize();
      }

      // Customization & Controls
      match /keyboardShortcuts/{shortcutId} {
        allow read, write: if isOwner(userId) && isSafeSize();
      }

      match /dataControls/{doc} {
        allow read, write: if isOwner(userId) && isSafeSize();
      }

      match /storage/{doc} {
        allow read, write: if isOwner(userId) && isSafeSize();
      }

      match /safetyConfig/{doc} {
        allow read, write: if isOwner(userId) && isSafeSize();
      }

      match /notifications/{doc} {
        allow read, write: if isOwner(userId) && isSafeSize();
      }

      // User Image Generation & Quotas
      match /imageQuota/{doc} {
        allow read, write: if isOwner(userId);
      }

      // Data Exports
      match /exports/{exportId} {
        allow read, create, delete: if isOwner(userId) && isSafeSize();
        allow update: if false;
      }
    }

    // ==========================================
    // 2. USER DAILY QUOTA & USAGE (TOP LEVEL)
    // ==========================================
    match /quotas/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ==========================================
    // 3. TOP LEVEL PROJECTS
    // ==========================================
    match /projects/{projectId} {
      allow read, write: if isAuth() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        request.resource.data.userId == request.auth.uid
      );
    }

    // ==========================================
    // 4. BUG REPORTS & SUPPORT TICKETS
    // ==========================================
    match /bugTickets/{ticketId} {
      // Anyone can submit a bug report with safe payload size
      allow create: if isSafeSize();
      // Only author or admin can read their submitted ticket
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || 
        resource.data.email == request.auth.token.email
      );
      allow update, delete: if false;
    }

    // ==========================================
    // 5. GLOBAL METRICS & SYSTEM STATUS (READ ONLY)
    // ==========================================
    match /imageQuotaGlobal/{doc} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /systemStatus/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ==========================================
    // DEFAULT DENY FOR ALL OTHER DOCUMENTS
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}